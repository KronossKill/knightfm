# ─────────────────────────────────────────────────────────────────
# Knight FM — variables de entorno (PLANTILLA). Copia este archivo
# a ".env" y rellena los valores. NUNCA subas tu .env real a GitHub.
# ─────────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL en producción, p.ej. Supabase pooled URI)
DATABASE_URL="postgresql://usuario:contrasena@host:5432/knightfm"

# Secret de firmas de sesión (obligatorio; 32+ caracteres aleatorios)
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# Cron del salario (Vercel Cron manda este header; inventa un valor largo)
CRON_SECRET="cambia-esto-tambien"

# Correo saliente (verificación de cuentas / recuperación).
# EMAIL_PROVIDER: console = no envía nada (escribe el código/token en los
# logs del servidor — solo para pruebas locales), smtp o resend en producción.
EMAIL_PROVIDER="console"
EMAIL_FROM="Knight FM <no-reply@tu-dominio.com>"
# Opción SMTP:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Opción Resend:
RESEND_API_KEY=""

# Cloudflare Turnstile (captcha). Con TURNSTILE_DISABLED=1 el registro pide
# solo presencia de token (modo pruebas locales); en producción configura
# las claves reales del widget para tu dominio.
TURNSTILE_DISABLED="1"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
