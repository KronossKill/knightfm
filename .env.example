# ─── Database ────────────────────────────────────────────────────────────────
# Sandbox local (SQLite):
DATABASE_URL="file:./db/custom.db"
# Production (Vercel + Supabase Postgres) — value must start with postgresql://
# DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ─── Knight Assistant (AI) — REQUIRED in production (Vercel) ─────────────────
# The z-ai-web-dev-sdk reads the .z-ai-config FILE in local sandboxes, but that
# file cannot ship to Vercel. In production these env vars are mandatory
# (src/app/api/assistant/route.ts uses env-first getZAI()).
# Values: copy them from your .z-ai-config file.
ZAI_BASE_URL="https://api.z.ai/api/coding/paas/v4"
ZAI_API_KEY="your-api-key-here"
ZAI_CHAT_ID="your-chat-id"
ZAI_USER_ID="your-user-id"
ZAI_TOKEN="your-token-if-any"

# ─── Email (Brevo SMTP or console) ───────────────────────────────────────────
# console  → emails are written to the server log (sandbox default)
# smtp     → real delivery via Brevo (300 emails/day free)
EMAIL_PROVIDER="console"
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="your-brevo-smtp-key"
# SMTP_PASS="your-brevo-smtp-secret"
# EMAIL_FROM="Knight FM <no-reply@yourdomain.com>"

# ─── CAPTCHA (Cloudflare Turnstile) ──────────────────────────────────────────
# Both keys together activate the real gate (register/login/withdrawals).
# Only one of them = degrades to sandbox (never locks users out).
# Emergency switch: TURNSTILE_DISABLED="1"
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# ─── Solana (deposits/withdrawals verification) ──────────────────────────────
# RPC endpoint used to verify on-chain transactions. Without it the deposit
# endpoint responds honestly with 503 (never fabricates balances).
# SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
